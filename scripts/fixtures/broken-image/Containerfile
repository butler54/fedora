# bootc/Containerfile — hardened Fedora 44 VM image (feature 002)
#
# Rules enforced by the pipeline (spec FR + research D5):
#   - Base pinned by digest (bootc/variables.env, updated by explicit commit only).
#   - Bundles over packages: declare dnf GROUPS; individual packages only when no
#     group owns the intent. Declaring a package that lives inside a declared
#     group is a hard pipeline error (stage_build lid check).
#   - No secrets, no credentials, no host-specific data.

FROM quay.io/fedora/fedora-bootc:44@sha256:2bf2d0403ed546aa4ae90bb8ba684986cce183868d2f3adb7de69f1d0cf86b2d

LABEL org.opencontainers.image.title="hardened-f44" \
      org.opencontainers.image.description="Locked-down Fedora 44 bootc VM image (feature 002)" \
      org.opencontainers.image.source="https://github.com/butler54/fedora"

# Bundle: container hosting surface for the VM (podman, buildah, skopeo, runc,
# containernetworking). Justification: lab workloads run as containers per
# constitution P.V; no GUI, no desktop groups.
RUN dnf install -y @container-management \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf* /var/cache/ldconfig

# --- Runtime hardening (image content) --------------------------------------
COPY files/etc/ssh/sshd_config.d/50-hardened.conf /etc/ssh/sshd_config.d/50-hardened.conf
COPY files/etc/systemd/system-preset/90-hardened.preset /etc/systemd/system-preset/90-hardened.preset

# --- Post-build surface assertions (fail the build if the base drifts) ------
RUN set -e; \
    # no GUI servers expected in this image
    ! rpm -q xorg-x11-server-Xorg >/dev/null 2>&1; \
    # SELinux support present (mode set at boot, Enforcing by default policy)
    rpm -q selinux-policy-targeted >/dev/null 2>&1; \
    # sshd present (openssh-server ships in the bootc base)
    rpm -q openssh-server >/dev/null 2>&1; \
    # podman must come from our group
    rpm -q podman >/dev/null 2>&1; \
    echo "containerfile-assertions-ok"
