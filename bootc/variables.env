# bootc/variables.env — pinned references for the hardened F44 pipeline
# Feature 002. Digest bump requires an explicit commit (constitution supply-chain rule).

# quay.io/fedora/fedora-bootc:44 manifest-index digest (multi-arch; amd64 child
# sha256:a2869ab8fa050e8030b37cba3d518b47a1922dad5ac879ced26e84b7459b3882)
BASE_IMAGE=quay.io/fedora/fedora-bootc:44
BASE_DIGEST=sha256:2bf2d0403ed546aa4ae90bb8ba684986cce183868d2f3adb7de69f1d0cf86b2d

# quay.io/centos-bootc/bootc-image-builder:latest manifest-index digest
BUILDER_IMAGE=quay.io/centos-bootc/bootc-image-builder
BUILDER_DIGEST=sha256:2b52843ea2bfda73b0a08d97e76b734393b1d3a804681b9fabb26723bd3a2f0b

# Default registry target for built images (parameter --registry-ref overrides).
# Namespace placeholder — fill at first run; never commit credentials.
REGISTRY_REF_DEFAULT=quay.io/NAMESPACE/hardened-f44:latest
